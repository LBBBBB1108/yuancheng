<Window x:Class="Yuancheng.Agent.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="欢迎测试" Height="650" Width="920" MinHeight="560" MinWidth="760"
        WindowStartupLocation="CenterScreen" Background="#EEF1E8">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="BuildLabel" Text="公司远程协助测试版" Foreground="#406551"
                           FontWeight="SemiBold" FontSize="14" />
                <TextBlock x:Name="WelcomeTitle" Text="欢迎测试" FontWeight="Bold" FontSize="38"
                           Foreground="#18231F" Margin="0,6,0,0" />
            </StackPanel>
            <Border Grid.Column="1" CornerRadius="18" Background="#DCE6DD" Padding="16,9">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#9A7440" Margin="0,0,8,0" />
                    <TextBlock x:Name="StatusText" Text="正在准备连接" Foreground="#314A3C" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="1" Margin="0,30" CornerRadius="22" BorderBrush="#D2D8CC" BorderThickness="1"
                Background="#FFFFFC" ClipToBounds="True">
            <Grid>
                <StackPanel x:Name="DefaultWelcome" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="远程协助" FontSize="42" FontWeight="Bold" Foreground="#244C38"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="欢迎图尚未设置，连接状态与停止按钮仍然可用" Margin="0,12,0,0"
                               Foreground="#657168" FontSize="15" />
                </StackPanel>
                <Image x:Name="WelcomeImage" Stretch="Uniform" Visibility="Collapsed" />
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="设备名称" Foreground="#6C756F" FontSize="12" />
                <TextBlock x:Name="DeviceNameText" FontWeight="SemiBold" FontSize="17" Foreground="#18231F" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="更换欢迎图" Click="ChooseImage_Click" Padding="18,11" Margin="0,0,10,0" />
                <Button Content="停止远控" Click="StopAssistance_Click" Padding="18,11" Margin="0,0,10,0"
                        Background="#9A332D" Foreground="White" />
                <Button Content="退出客户端" Click="ExitClient_Click" Padding="18,11"
                        Background="{StaticResource AccentBrush}" Foreground="White" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
