<Window x:Class="Yuancheng.Agent.ConsentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="远程协助确认" Width="440" Height="310" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Topmost="True">
    <StackPanel Margin="28">
        <TextBlock Text="管理员请求远程协助" FontSize="22" FontWeight="Bold" />
        <TextBlock x:Name="AdministratorText" Margin="0,18,0,0" TextWrapping="Wrap" />
        <TextBlock x:Name="PermissionText" Margin="0,10,0,0" TextWrapping="Wrap" />
        <TextBlock x:Name="DeadlineText" Margin="0,10,0,18" Foreground="#9A332D" />
        <TextBlock Text="确认流程已接通，远程画面、控制和文件功能尚未开放。" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="拒绝" Click="Reject_Click" Padding="18,8" Margin="0,0,10,0" />
            <Button Content="同意" Click="Accept_Click" Padding="18,8" />
        </StackPanel>
    </StackPanel>
</Window>
